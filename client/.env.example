# Plannova Frontend Environment Variables

# In development: http://localhost:5000/api
# In production (e.g. deployed on Vercel/Netlify): https://your-backend-api.onrender.com/api
# If backend serves frontend from the same origin: leave empty or /api
VITE_API_URL=https://plannova-backend.onrender.com/api

# Optional: Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=
